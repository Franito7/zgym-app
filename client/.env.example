# ==============================================================================
# ZGYM SAAS - VARIABLES DE ENTORNO (CLIENTE PWA / VERCEL)
# ==============================================================================
# La aplicación es 100% Serverless: se conecta directamente a Supabase
# (Auth, PostgreSQL DB, Storage) sin depender de un servidor Express local.

# 1. URL de tu proyecto en Supabase (Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# 2. Clave pública anónima (Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Nombre del bucket de almacenamiento para videos/imágenes de ejercicios (público)
VITE_SUPABASE_STORAGE_BUCKET=zgym-media
