# ==============================================================================
# ZGYM SAAS - VARIABLES DE ENTORNO (BACKEND API)
# ==============================================================================

PORT=5000
NODE_ENV=production
CLIENT_URL=https://tu-app-en-vercel.vercel.app

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS SUPABASE (POSTGRESQL REAL) - RECOMENDADO PARA VERCEL
# ------------------------------------------------------------------------------
# Obtené esta URL en: Supabase Project Settings > Database > Connection String (URI / Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE & CLIENT (VIDEOS, PDFS Y AUDITORÍAS PERMANENTES)
# ------------------------------------------------------------------------------
# Obtené estas claves en: Supabase Project Settings > API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (exclusiva del backend para gestionar archivos y saltar RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=zgym-media

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_zgym_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. MODO OFFLINE / DESARROLLO LOCAL (FALLBACK AUTOMÁTICO)
# ------------------------------------------------------------------------------
# Si DATABASE_URL está vacía, el servidor usa automáticamente SQLite persistente
# en: server/data/gym_platform.db y guarda uploads en server/uploads/
